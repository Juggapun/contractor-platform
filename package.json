{
  "name": "contractor-platform",
  "private": true,
  "type": "module",
  "description": "ศูนย์รวมผู้รับเหมาไทย — Supabase/PostgreSQL database + authentication + Home Page (Phase 2-4)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:lib": "tsc -p tsconfig.build.json",
    "generate-districts-snapshot": "node scripts/generate-districts-snapshot.mjs",
    "seed-districts": "node scripts/seed-districts.mjs",
    "local-db:bootstrap": "echo 'run: sudo -u postgres psql -d <db> -f supabase/local-dev/00_bootstrap.sql (before the numbered migrations)'",
    "local-db:shim": "node supabase/local-dev/postgrest-shim.mjs",
    "local-db:security-tests": "node supabase/local-dev/run-security-tests.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test": "npm run typecheck && npm run lint && npm run build && npm run test:unit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "pg": "^8.11.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
