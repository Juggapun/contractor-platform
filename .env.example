# Copy this file to .env (already git-ignored) and fill in real values
# from your Supabase project's Settings > API page. NEVER commit a real
# .env file. See docs/AUTHENTICATION.md#environment-variables for which
# of these are safe to ship to a browser bundle vs. server-only.

# --- Client-safe (fine to ship in a browser bundle) ---------------------
# MUST use the NEXT_PUBLIC_ prefix and MUST be read via literal
# `process.env.NEXT_PUBLIC_...` (not a dynamic process.env[name] lookup)
# — that's the only pattern Next.js's build actually inlines into a
# browser bundle. A non-prefixed name here would silently be undefined
# in client-side code (a real bug found in Phase 6 — see
# docs/PHASE6-CONTRACTOR-PROFILE-REPORT.md).
#
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The `anon` / `publishable` key. Despite living in frontend code, this
# key grants nothing by itself — every table it can touch is gated by
# Row Level Security (supabase/migrations/0013_rls_policies.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- SERVER-ONLY — never bundle, never log, never send to a browser ----
# (src/lib/supabase/admin.ts reuses NEXT_PUBLIC_SUPABASE_URL above for
# the project URL — that half isn't secret; only the key below is.)
#
# The `service_role` / `secret` key. BYPASSES ROW LEVEL SECURITY
# ENTIRELY. Only ever read by src/lib/supabase/admin.ts, and only from
# trusted server-side processes (a backend server, a serverless
# function, a CLI script) — never from code that ships to a browser.
# Deliberately NOT NEXT_PUBLIC_-prefixed — that prefix is exactly what
# would make Next.js inline it into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local-dev-only (see supabase/local-dev/README.md) ------------------
# Only needed when running the local Postgres emulation harness instead
# of a real hosted Supabase project. Not used by src/lib at all.
LOCAL_DB_AUTHENTICATOR_PASSWORD=
